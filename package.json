{
  "name": "personal-memory",
  "version": "0.4.0",
  "private": true,
  "description": "Local RAG personal memory store",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "memory": "./src/cli.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts ui",
    "memory": "tsx src/cli.ts",
    "index": "tsx src/cli.ts index",
    "bench:graph": "tsx scripts/graph-bench.ts",
    "test": "node --import tsx --test src/*.test.ts src/ui/*.test.js && bash scripts/migration-scripts.test.sh && bash scripts/memory-guards.test.sh",
    "typecheck": "tsc --noEmit && tsc -p src/ui",
    "eval": "tsx scripts/eval-retrieval.ts --size 4000 --compare docs/eval/baseline-4k.json",
    "eval:baseline": "tsx scripts/eval-retrieval.ts --size 4000 --json docs/eval/baseline-4k.json --md docs/eval/baseline.md",
    "eval:scale": "tsx scripts/eval-retrieval.ts --size 20000 && tsx scripts/eval-retrieval.ts --size 50000"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@lancedb/lancedb": "^0.37.1",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
